{
  "name": "rosie-ui",
  "version": "0.3.0",
  "description": "JavaScript library that build on top of React 19.2 and Bootstrap 5.3, helping you build data-intensive, cross-platform web apps for desktops, tablets, and smartphones.",
  "author": "Lionel Nguyen <huynguyen8505@gmail.com> (https://github.com/huytrongnguyen)",
  "license": "MIT",
  "repository": "https://github.com/huytrongnguyen/rosie",
  "bugs": "https://github.com/huytrongnguyen/rosie/issues",
  "source": "ts/index.ts",
  "main": "dist/js/index.js",
  "types": "./dist/js/index.d.ts",
  "targets": {
    "main": {
      "optimize": true
    }
  },
  "files": [
    "dist",
    "scss",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "npm run fonts && npm run css && npm run js",
    "js": "tsc",
    "css": "sass scss/index.scss dist/css/rosie.css --style=compressed --no-source-map"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "axios": "1.14.0",
    "bootstrap": "5.3.8"
  },
  "peerDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/bootstrap": "5.2.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "sass": "1.98.0",
    "typescript": "6.0.2"
  }
}
