{
  "name": "rosie-ui",
  "version": "0.5.0",
  "description": "Rosie UI — a pastel, token-based design system (styles + core scripts) for data-intensive, cross-platform web apps.",
  "author": "Lionel Nguyen <huynguyen8505@gmail.com> (https://github.com/huytrongnguyen)",
  "license": "MIT",
  "repository": "https://github.com/huytrongnguyen/rosie",
  "bugs": "https://github.com/huytrongnguyen/rosie/issues",
  "type": "module",
  "main": "./dist/js/index.js",
  "module": "./dist/js/index.js",
  "types": "./dist/js/index.d.ts",
  "style": "dist/css/rosie.css",
  "sass": "scss/index.scss",
  "sideEffects": [
    "*.css",
    "*.scss",
    "./ts/core/lang/*.ts",
    "./dist/js/core/lang/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./css": "./dist/css/rosie.css",
    "./scss": "./scss/index.scss",
    "./scss/*": "./scss/*"
  },
  "files": [
    "dist",
    "scss",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "npm run css && npm run js && npm run js-bundle",
    "css": "sass scss/index.scss dist/css/rosie.css --style=compressed --no-source-map",
    "js": "tsc",
    "js-bundle": "esbuild ts/bundle.ts --bundle --outfile=dist/js/rosie.bundle.js --format=iife",
    "prepublishOnly": "npm run build",
    "demo": "npm run demo-css && npm run demo-js",
    "demo-js": "esbuild demo/ts/app.tsx --bundle --outfile=demo/dist/demo.js --loader:.tsx=tsx --format=iife --alias:rosie-ui=./ts/index.ts",
    "demo-css": "sass demo/scss/demo.scss demo/dist/demo.css --load-path=. --no-source-map",
    "demo-watch": "npm run demo-css -- --watch & npm run demo-js -- --watch"
  },
  "peerDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.27.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sass": "1.98.0",
    "typescript": "6.0.2"
  }
}
